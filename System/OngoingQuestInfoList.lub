QuestInfoList = {
	[16691] = {
		Title = "Expand Exploration Range",
		IconName = "ico_ep.bmp",
		Description = { "Let's go investigate the unexplored area of the <NAVI>[Ancient Ice Canyon]<INFO>jor_back5,350,75,0,101,0</INFO></NAVI>." },
		Summary = "Explore the Ancient Ice Canyon"
	},
	[16692] = {
		Title = "The Natives of the Ancient Ice Canyon",
		IconName = "ico_ep.bmp",
		Description = { "We were attacked by the ancient Icewinds in the Ancient Ice Canyon. Let's take refuge for now in <NAVI>[a safe place]<INFO>jor_back5,350,75,0,101,0</INFO></NAVI>." },
		Summary = "Take Refuge in a Safe Place"
	},
	[16693] = {
		Title = "Exploration of the Ancient Ice Canyon",
		IconName = "ico_ep.bmp",
		Description = { "We found suspicious installations and traces that seem to belong to Rgan in the Ancient Ice Canyon. Let's further investigate the <NAVI>[surroundings]<INFO>jor_back5,353,357,0,101,0</INFO></NAVI>." },
		Summary = "Explore the Ancient Ice Canyon"
	},
	[16694] = {
		Title = "Evidence and Return",
		IconName = "ico_ep.bmp",
		Description = { "We acquired a suspicious device. Let's return to <NAVI>[the Ice Castle]<INFO>icas_in,262,202,0,101,0</INFO></NAVI> to examine the device." },
		Summary = "Return to the Ice Castle"
	},
	[16695] = {
		Title = "Suspicious Signs",
		IconName = "ico_ep.bmp",
		Description = { "Horuru seems to have something to say to the adventurer. He says he'll be waiting in the <NAVI>[corner]<INFO>icas_in,259,219,0,101,0</INFO></NAVI> of the Ice Castle adventurer's lodging." },
		Summary = "Talk to Horuru"
	},
	[16696] = {
		Title = "Military Camp Investigation",
		IconName = "ico_ep.bmp",
		Description = { "Let's conduct an investigation to see if there are any suspicious signs in the <NAVI>[military camp]<INFO>icas_in,113,41,0,101,0</INFO></NAVI> in the Ice Castle." },
		Summary = "Military Camp Investigation"
	},
	[16697] = {
		Title = "Lodge Investigation",
		IconName = "ico_ep.bmp",
		Description = { "Let's conduct an investigation to see if there are any suspicious signs in the <NAVI>[lodge]<INFO>icas_in,92,113,0,101,0</INFO></NAVI> in the Ice Castle." },
		Summary = "Lodge Investigation"
	},
	[16698] = {
		Title = "Back Alley Exploration",
		IconName = "ico_ep.bmp",
		Description = { "Investigate for any suspicious signs in the <NAVI>[Back Alley]<INFO>icecastle,209,243,0,101,0</INFO></NAVI> of Ice Castle." },
		Summary = "Back Alley Investigation"
	},
	[16699] = {
		Title = "Suspicious Signs?",
		IconName = "ico_ep.bmp",
		Description = { "Were there any suspicious signs? Since the investigation in the designated area is complete, let's return to <NAVI>[Horuru]<INFO>icas_in,259,219,0,101,0</INFO></NAVI> at Ice Castle Adventurer's Lodge." },
		Summary = "Talk to Horuru"
	},
	[16700] = {
		Title = "Identity of the Suspicious Device",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Vellgunde]<INFO>icas_in,260,205,0,101,0</INFO></NAVI> has discovered the identity of the suspicious device. Let's hear the details at the Ice Castle Adventurer's Lodge." },
		Summary = "Talk to Vellgunde"
	},
	[16701] = {
		Title = "Canyon Exploration",
		IconName = "ico_ep.bmp",
		Description = { "Lehar is preparing for a canyon exploration at <NAVI>[Front of Ice Castle]<INFO>icecastle,201,171,0,101,0</INFO></NAVI>. After the preparations are complete, let's head to the castle front." },
		Summary = "Talk to Lehar"
	},
	[16702] = {
		Title = "Return to Ice Castle",
		IconName = "ico_ep.bmp",
		Description = { "Many things have happened. Return to <NAVI>[Ice Castle]<INFO>icas_in,259,200,0,101,0</INFO></NAVI> to inform Miriam and the adventurer of our safe return." },
		Summary = "Talk to Miriam"
	},
	[16703] = {
		Title = "Recent Events",
		IconName = "ico_ep.bmp",
		Description = { "At the <NAVI>[Adventurer's Lodge]<INFO>icas_in,263,200,0,101,0</INFO></NAVI> in Ice Castle, let's talk about the events witnessed during the escape and make plans for the future." },
		Summary = "Talk to Lazy"
	},
	[16704] = {
		Title = "Era of Cold War and Espionage",
		IconName = "ico_ep.bmp",
		Description = { "We have decided to transform into high-level Rgans and infiltrate the gaps among the Rgans. Let's start the spy operation from <NAVI>[Front of Snake's Nest]<INFO>jor_nest,36,274,0,101,0</INFO></NAVI>." },
		Summary = "Gather at Front of Snake's Nest Door"
	},
	[17690] = {
		Title = "A New Exploration Site",
		IconName = "ico_ep.bmp",
		Description = { "Gather at the inner part of <NAVI>[Ice Castle]<INFO>icas_in,262,202,0,101,0</INFO></NAVI> to discuss a new exploration site." },
		Summary = "To the Ice Castle"
	},
	[17691] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "The previously sealed door of <NAVI>[Lair of the Serpent]<INFO>jor_nest,36,274,0,101,0</INFO></NAVI> has been opened. Now, it's just a matter of entering while transformed into Rgan using a transformation scroll." },
		Summary = "The Door Is Open"
	},
	[17692] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "After transforming into Rgan using a transformation scroll, entered the opened Lair of the Serpent's <NAVI>[Beyond]<INFO>jor_root1,32,34,0,101,0</INFO></NAVI>. Let's investigate thoroughly." },
		Summary = "To the Roots of the Serpent"
	},
	[17693] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Identified some unusual Rgan who appear human. First, let's deal with these creatures and then search for the <NAVI>[Companions]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> in the roots of the serpent." },
		Summary = "Defeat 5 Superior Rgan Warlocks"
	},
	[17694] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Lazy went ahead to explore the interior. Let's wait for Lazy in the <NAVI>[Sanctuary]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> within the roots of the serpent." },
		Summary = "Aiding Lazy the Resolver"
	},
	[17695] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Lazy suggested disguising as Rgan bishops and infiltrating the <NAVI>[Sanctuary]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> within the roots of the serpent. Is this Lazy's plan?" },
		Summary = "Lazy's Stratagem?"
	},
	[17696] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "The party decided to use the appearance of Lazy, disguised as a top-tier Rgan, to enter the <NAVI>[Sacred Roots]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI>." },
		Summary = "To the Sacred Roots"
	},
	[17697] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "When arriving at the Sacred Roots, top-tier <NAVI>[Rgan]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> individuals stood in line, seeking assistance. Let's help them wholeheartedly." },
		Summary = "Assisting Rgan's Tasks 1"
	},
	[17698] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "Go out to <NAVI>[Lair of the Serpent]<INFO>jor_root2,26,271,0,101,0</INFO></NAVI> and gather three snakeberries, which our <NAVI>[Bishops]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> enjoy." },
		Summary = "Collect 3 Snakeberries"
	},
	[17699] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "We obtained some information about the Sacred Roots from the top-tier Rgan. Let's get more information from other top-tier <NAVI>[Rgan]<INFO>jor_sanct,185,128,0,101,0</INFO></NAVI> individuals in the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 2"
	},
	[17700] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "We learned about the Magic Absorption Device and the Iwin Transformation Device from a top-tier Rgan. Let's seek more information from other top-tier <NAVI>[Rgan]<INFO>jor_sanct,42,105,0,101,0</INFO></NAVI> individuals in the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 3"
	},
	[17701] = {
		Title = "Earning Rgan's Trust",
		IconName = "ico_ep.bmp",
		Description = { "To acquire more information, we need to gain Rgan's trust. Let's assist Rgan individuals in need, including <NAVI>[Pamoshugand]<INFO>jor_sanct,257,115,0,101,0</INFO></NAVI>, at the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 4"
	},
	[17702] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand, known as Rasgand's right hand, will quietly approach adventurers in front of the <NAVI>[Door]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI> leading to the Serpent's Maze." },
		Summary = "To the Serpent's Maze"
	},
	[17703] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "There are parasites living in the Serpent's Maze beyond this door. It seems like some cleaning is needed. Before that person arrives, deal with three of them and return to <NAVI>[Sacred Roots]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI>." },
		Summary = "Defeat 3 parasites in the Serpent's Maze"
	},
	[17704] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand, known as Rasgand's right hand, said he is going to meet Rasgand. Let's investigate Sarekgand's <NAVI>[Traces]<INFO>jor_maze,15,47,0,101,0</INFO></NAVI> within the Serpent's Maze." },
		Summary = "Finding Sarekgand's Traces 1"
	},
	[17705] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand's traces are sporadically present. It seems like a more thorough search of <NAVI>[Serpent's Maze]<INFO>jor_maze,17,153,0,101,0</INFO></NAVI> is necessary." },
		Summary = "Finding Sarekgand's Traces 2"
	},
	[17706] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "After parting ways with the party, you are left alone. Investigate <NAVI>[Serpent's Maze]<INFO>jor_maze,140,71,0,101,0</INFO></NAVI> for Sarekgand's traces." },
		Summary = "Finding Sarekgand's Traces 3"
	},
	[17707] = {
		Title = "Unexpected Reunion",
		IconName = "ico_ep.bmp",
		Description = { "There is a suspicious <NAVI>[Device]<INFO>jor_maze,140,71,0,101,0</INFO></NAVI> in the Serpent's Maze. The only person who could have created such a device is Bagot. Investigating the device may provide clues." },
		Summary = "Investigating the Suspicious Device"
	},
	[17708] = {
		Title = "Unexpected Reunion",
		IconName = "ico_ep.bmp",
		Description = { "During a confrontation with Rasgand, a white cat suddenly appeared and sent Rasgand's group flying, including the adventurer <NAVI>[Party]<INFO>jor_back1,365,226,0,101,0</INFO></NAVI>, to the frozen Scaled Hill." },
		Summary = "The Power of the White Cat"
	},
	[17709] = {
		Title = "Report on Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Return to <NAVI>[Ice Castle]<INFO>icas_in,226,255,0,101,0</INFO></NAVI> and report the information about 'that place' and Rasgand." },
		Summary = "To the Ice Castle"
	},
	[17712] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "It's said that the top-tier Rgan we captured earlier is causing trouble. Let's go to the Ice Castle following <NAVI>[Iwin Soldier]<INFO>icecastle,46,164,0,101,0</INFO></NAVI> asking for help." },
		Summary = "To the Ice Castle"
	},
	[17713] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Horuru]<INFO>icas_in2,31,116,0,101,0</INFO></NAVI> is in a dilemma because of Nadyagand's demands for keeping him imprisoned in the Ice Castle." },
		Summary = "Distinguished Guest"
	},
	[17714] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "To make Nadyagand, who is imprisoned in the Ice Castle, talk, we need to bring the snakeberries he demands. Let's go to <NAVI>[Snake God's Roots]<INFO>jor_root2,25,21,0,101,0</INFO></NAVI> and gather 10 snakeberries." },
		Summary = "Collect 10 Snakeberries"
	},
	[17715] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "We've obtained the snakeberries, but the top-tier Rgan knows nothing. Just when he was about to give in to the idea of sitting in the Ice Castle, <NAVI>[Lazy]<INFO>icas_in2,32,120,0,101,0</INFO></NAVI> appeared. Let's seek advice from Lazy." },
		Summary = "Conversation with Lazy"
	},
	[17716] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "Lazy easily persuaded Nadyagand to work without any intentions of playing or eating. How? Let's ask <NAVI>[Lazy]<INFO>icas_in2,32,120,0,101,0</INFO></NAVI> for the details when visiting the Ice Castle." },
		Summary = "Conversation with Lazy"
	},
	[17719] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "Deliver snakeberries to the Rgan <NAVI>[Bishop]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> in the Sacred Roots." },
		Summary = "Deliver Snakeberries"
	},
	[8839] = {
		Title = "Reluctantly pretending to help",
		IconName = "ico_ep.bmp",
		Description = { "Sacred Roots here and there are in need of \"capable messengers\" who have just returned from reconnaissance. Without even knowing who they really are. * <NAVI>[Gomiagand]<INFO>jor_sanct,215,84,0,101,0</INFO></NAVI> * <NAVI>[Holsibigand]<INFO>jor_sanct,190,128,0,101,0</INFO></NAVI> * <NAVI>[Pamoshugand]<INFO>jor_sanct,257,115,0,101,0</INFO></NAVI> * <NAVI>[Nalsioramigand]<INFO>jor_sanct,271,156,0,101,0</INFO></NAVI> * <NAVI>[Eririgand]<INFO>jor_sanct,101,138,0,101,0</INFO></NAVI>" },
		Summary = "Helping Rgan's in trouble"
	},
	[8840] = {
		Title = "Rgan's Trust",
		IconName = "ico_ep.bmp",
		Description = { "Strangely, it became a popular body among top-notch Rgans. There were only those who were stubborn and had strange personalities. I think I can talk to <NAVI>[Sarekgand]<INFO>jor_sanct,157,171,0,101,0</INFO></NAVI> now." },
		Summary = "Talk to Sarekgand"
	},
	[8841] = {
		Title = "But think about it",
		IconName = "ico_ep.bmp",
		Description = { "Sacred Root's <NAVI>[Gomiagand]<INFO>jor_sanct,215,84,0,101,0</INFO></NAVI> seems to have a lot to say, but it's not easy because his direct subordinate, Gamirabagand, keeps arguing." },
		Summary = "Talk to Gomiagand"
	},
	[8842] = {
		Title = "You are very angry",
		IconName = "ico_ep.bmp",
		Description = { "Sacred Root's <NAVI>[Holsibigand]<INFO>jor_sanct,190,128,0,101,0</INFO></NAVI> asks you to bring 30x <ITEM>[Copo's Feathers]<INFO>1001246</INFO></ITEM>." },
		Summary = "Deliver 30 Copo's Feathers"
	},
	[8843] = {
		Title = "Silent Answer",
		IconName = "ico_ep.bmp",
		Description = { "Pamoshugand of the Sacred Root asks you to get 20x <ITEM>[Large Gray Feather]<INFO>1001244</INFO></ITEM>. Leaving <NAVI>[Doririrogand]<INFO>jor_sanct,258,117,0,101,0</INFO></NAVI> alone, who was assigned as his direct subordinate... !" },
		Summary = "After delivering the items, talk to Doririrogand"
	},
	[8846] = {
		Title = "I came all the way here",
		IconName = "ico_ep.bmp",
		Description = { "Work is not assigned to intermediate Rgans who have followed their Sacred Roots. Each should be assigned a task to do. * <NAVI>[Puddle]<INFO>jor_sanct,48,159,0,101,0</INFO></NAVI> * <NAVI>[Tower]<INFO>jor_sanct,95,152,0,101,0</INFO></NAVI> * <NAVI>[Garbage]<INFO>jor_root2,12,172,0,101,0</INFO></NAVI> * <NAVI>[A mountain of junk]<INFO>jor_root2,242,124,0,101,0</INFO></NAVI> * <NAVI>[Warehouse]<INFO>jor_root2,149,125,0,101,0</INFO></NAVI>" },
		Summary = "Intermediate Rgan Job Search"
	},
	[8847] = {
		Title = "Nalsioramigand's Work",
		IconName = "ico_ep.bmp",
		Description = { "I found something to do for Nalsioramigand." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8848] = {
		Title = "Numkasaigagand's Work",
		IconName = "ico_ep.bmp",
		Description = { "I found something to do for Numkasaigagand." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8849] = {
		Title = "Onnaecheramelgand's Work",
		IconName = "ico_ep.bmp",
		Description = { "I found something to do for Onnaecheramelgand." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8850] = {
		Title = "Jakreudagumigand's Work",
		IconName = "ico_ep.bmp",
		Description = { "I found something to do for Jakreudagumigand." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8851] = {
		Title = "Kljeinamogand's Work",
		IconName = "ico_ep.bmp",
		Description = { "I found something to do for Kljeinamogand." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8854] = {
		Title = "I probably have a lunch box",
		IconName = "ico_ep.bmp",
		Description = { "Did <NAVI>[Eririgand]<INFO>jor_sanct,101,138,0,101,0</INFO></NAVI> really tell this story to everyone?" },
		Summary = "Talk to Eririgand"
	},
	[23100] = {
		Title = "Ancient Deep Sea",
		IconName = "ico_ep.bmp",
		Description = { "In the confrontation situation with Rasgand, it's possible that Jormungandr saved us. To find the place where you met the White Cat, visit <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Diving Iwin"
	},
	[23101] = {
		Title = "No Matter How Deep, I Can Find It 1",
		IconName = "ico_ep.bmp",
		Description = { "Diving Iwin from the Ice Castle suggests that he needs a high-calorie meal to swim to the Frozen Zone. Hunt 5 Ice Gangus nearby and bring 3 Frozen Beetle Shells." },
		Summary = "5 Ice Gangus, 3 Frozen Insect Shells"
	},
	[23102] = {
		Title = "No Matter How Deep, I Can Find It 2",
		IconName = "ico_ep.bmp",
		Description = { "Diving Iwin from the Ice Castle suggests that he needs a protective suit made of shining seaweed to swim to the Frozen Zone. Collect 5 Luminous Seaweeds nearby and bring 3 Luminous Seaweed Stems." },
		Summary = "5 Shining Seaweeds, 3 Shiny Seaweed Stems"
	},
	[23103] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "You've arrived at the Frozen Zone. It's a different place from where you met the White Cat... Check with <NAVI>[Kororo]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI> what's going on here. If you get lost on your way to the Frozen Zone, find <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle." },
		Summary = "Talk to Kororo"
	},
	[23104] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "You've arrived at the Frozen Zone. Now you just need to find the spot where you met the White Cat. There's no plan, but you decided to move anyway. Let's go wherever your feet take you. If you leave the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> will take you back." },
		Summary = "Find the White Cat"
	},
	[23105] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "Where on earth is this...? It seems like you're wandering around without a plan, but this is the only way to find the White Cat. Keep exploring the <NAVI>[Frozen Zone]<INFO>jor_twice,158,243,0,101,0</INFO></NAVI>. If you leave the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> will take you back." },
		Summary = "Find the White Cat again"
	},
	[23106] = {
		Title = "A Nest of Small Branches",
		IconName = "ico_ep.bmp",
		Description = { "You found a spot where you can sense the magic of Jormungandr and met a cat. However, the cat led Leon and Aurelie away. Let's follow them with <NAVI>[Lehar]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI> in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Find Leon and Aurelie"
	},
	[23107] = {
		Title = "A Nest of Small Branches",
		IconName = "ico_ep.bmp",
		Description = { "Leo seems to have too much on his mind after arriving at the Nest of Small Branches. Let's give him some time to sort his thoughts and then try talking to him." },
		Summary = "Talk to Leon"
	},
	[23108] = {
		Title = "Across the Iceberg and the Frozen Sea",
		IconName = "ico_ep.bmp",
		Description = { "You received an explanation about the Sanctum from Leon and Aurelie. Return to the <NAVI>[Frozen Zone]<INFO>jor_twice,161,243,0,101,0</INFO></NAVI> and share the information about the Nest of Small Branches with your companions. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Talk to Aurelie"
	},
	[23109] = {
		Title = "Across the Iceberg and the Frozen Sea",
		IconName = "ico_ep.bmp",
		Description = { "You received an explanation about the Sanctum from Aurelie. It seems like the followers of Jormungandr in the Frozen Zone are trying to absorb Jormungandr's magic. Defeat 5 Jormungandr Cult Ritualists nearby and return to <NAVI>[Aurelie]<INFO>jor_twice,161,243,0,101,0</INFO></NAVI> in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Defeat 5 Jormungandr Cult Ritualists"
	},
	[23112] = {
		Title = "The Serpent's Maze",
		IconName = "ico_ep.bmp",
		Description = { "You've decided to infiltrate the Serpent's Maze. Let's find <NAVI>[Lehar]<INFO>jor_maze,142,73,0,101,0</INFO></NAVI> inside the Maze." },
		Summary = "Talk to Lehar"
	},
	[23113] = {
		Title = "Gathering Rumors Among Jormungandrs 1",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,52,238,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23114] = {
		Title = "Gathering Rumors Among Jormungandrs 2",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,154,244,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23115] = {
		Title = "Gathering Rumors Among Jormungandrs 3",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,281,191,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23116] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "The Serpent's Maze feels even more mysterious than before. What could have happened in the meantime? Let's gather rumors among the Jormungandr followers." },
		Summary = "Gather rumors inside the Serpent's Maze"
	},
	[23117] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "It seems like you've gathered enough rumors among the Jormungandr followers in the Serpent's Maze. Return to the <NAVI>[Meeting Place]<INFO>jor_maze,150,33,0,101,0</INFO></NAVI> within the Maze." },
		Summary = "Talk to Miriam"
	},
	[23118] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "You've shared the rumors collected by your group inside the Serpent's Maze. Now, let's go further inside the <NAVI>[Inside the Maze]<INFO>jor_maze,197,35,0,101,0</INFO></NAVI>." },
		Summary = "Go further inside the Serpent's Maze"
	},
	[18220] = {
		Title = "To the Ice Castle",
		IconName = "ico_ep.bmp",
		Description = { "We've received the assistance of Lord Nyar. Let's return to the Ice Castle and check in with <NAVI>[Leon]<INFO>icas_in,111,228,0,101,0</INFO></NAVI> and our comrades." },
		Summary = "Conversation with Leon"
	},
	[18221] = {
		Title = "Finding Lehar...!",
		IconName = "ico_ep.bmp",
		Description = { "We've decided to find Lehar at the first floor of the Snake's Roots. Let's investigate the <NAVI>[Marker]<INFO>jor_root1,32,75,0,101,0</INFO></NAVI>." },
		Summary = "Investigate the Marker"
	},
	[18222] = {
		Title = "Investigation, Investigation, Investigation",
		IconName = "ico_ep.bmp",
		Description = { "After investigating the mark left in the Snake's Roots, Lehar suggested exchanging information at the Sacred Roots. There are a total of three marked locations." },
		Summary = "Investigate 3 Marks"
	},
	[18223] = {
		Title = "Lehar's Mark 1",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,69,128,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18224] = {
		Title = "Lehar's Mark 2",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,35,211,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18225] = {
		Title = "Lehar's Mark 3",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,254,66,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18226] = {
		Title = "It's Just a Hoax. The Next Location.",
		IconName = "ico_ep.bmp",
		Description = { "Even after investigating all the marks left in the Snake's Roots 1st floor, we couldn't find the entrance to Bagot's laboratory. Let's meet Lehar and Miriam at the <NAVI>[Sacred Roots]<INFO>jor_sanct,133,86,0,101,0</INFO></NAVI>." },
		Summary = "Investigate the Marks"
	},
	[18227] = {
		Title = "Investigating the Sacred Roots",
		IconName = "ico_ep.bmp",
		Description = { "Lehar and Miriam have decided to investigate the interior of the Sacred Roots together. Let's go to the central area and talk to <NAVI>[Bishop Rgan]<INFO>jor_sanct,150,207,0,101,0</INFO></NAVI> to gather information." },
		Summary = "Conversation with the Bishop"
	},
	[18228] = {
		Title = "Nyar's Call",
		IconName = "ico_ep.bmp",
		Description = { "Lured by a massive vibration, we arrived at the Small Twig Nest. The <NAVI>[White Cat]<INFO>jor_twig,187,198,0,101,0</INFO></NAVI> in the Small Twig Nest seems to have something to say. It looks urgent." },
		Summary = "Conversation with the White Cat"
	},
	[18229] = {
		Title = "Step on the Cats' Backs and Run!",
		IconName = "ico_ep.bmp",
		Description = { "Another massive vibration has occurred. It seems something is happening inside the Small Twig Nest <NAVI>[Inner Area]<INFO>jor_twig,180,123,0,101,0</INFO></NAVI>. Let's go and check it out!" },
		Summary = "Conversation with the White Cat"
	},
	[18230] = {
		Title = "Was Everyone Here?",
		IconName = "ico_ep.bmp",
		Description = { "Bagot and Rasgand, who we've been looking for, have somehow infiltrated the Small Twig Nest. We need to help <NAVI>[Nyar]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI> and Leon, who are facing off against Rasgand." },
		Summary = "Conversation with the White Cat"
	},
	[18231] = {
		Title = "So, What Happened?",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand, who infiltrated the Small Twig Nest, disappeared with <NAVI>[Nyar]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI>'s doppelganger. Let's ask <NAVI>[Leon]<INFO>jor_twig,138,157,0,101,0</INFO></NAVI> about Rasgand's whereabouts." },
		Summary = "Conversation with Leon"
	},
	[18232] = {
		Title = "Separated Sanctuary",
		IconName = "ico_ep.bmp",
		Description = { "Before Rasgand could steal the power of the World Tree and the Nest, he was isolated in a different dimension. Nyar, who forcibly separated Rasgand, seems to be struggling to maintain the barrier. Let's go to the 'Separated Sanctuary' through <NAVI>[Aurelie]<INFO>jor_twig,138,152,0,101,0</INFO></NAVI> and stop Rasgand." },
		Summary = "Neutralize Rasgand"
	},
	[18233] = {
		Title = "The Undying One",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand, who absorbed the power of Imir's Heart Shard, was an opponent we couldn't defeat. However, now that we have the tainted Imir's Heart Shard, let's return to <NAVI>[Ice Castle]<INFO>icecastle,158,204,0,101,0</INFO></NAVI>. Chichiring knows the location of <NAVI>[Voglinde]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>." },
		Summary = "Conversation with Voglinde"
	},
	[17710] = {
		Title = "Cleaning the Serpent's Maze",
		IconName = "ico_ep.bmp",
		Description = { "It's all about cleaning today! Eliminate 10 Jormungandr Guardians of each color in the Serpent's Maze and then return to <NAVI>[Sacred Roots]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI>." },
		Summary = "Dealing with Jormungandr Guardians"
	},
	[17711] = {
		Title = "[Standby] Cleaning the Serpent's Maze",
		IconName = "ico_dq.bmp",
		Description = { "After the dawn passes, go to the <NAVI>[Supervisor]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI> in the Sacred Roots to receive new cleaning tasks." },
		Summary = "4 AM Reset"
	},
	[17717] = {
		Title = "[Standby] Taste of Leisure",
		IconName = "ico_dq.bmp",
		Description = { "Unintentionally, we've decided to bring some snacks to <NAVI>[Nadyagand]<INFO>icas_in2,30,121,0,101,0</INFO></NAVI> who is working hard. Let's return to the Ice Castle after dawn." },
		Summary = "4 AM Reset"
	},
	[17718] = {
		Title = "Taste of Leisure",
		IconName = "ico_ep.bmp",
		Description = { "Let's gather 10 snakeberries from <NAVI>[Snake God's Roots]<INFO>jor_root2,25,21,0,101,0</INFO></NAVI> for <NAVI>[Nadyagand]<INFO>icas_in2,30,121,0,101,0</INFO></NAVI>, who is working diligently in the Ice Castle." },
		Summary = "Collect 10 Snakeberries"
	},
	[8844] = {
		Title = "[Standby] Example of Silent Answer",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest, and when the waiting time expires, you can receive it again from <NAVI>[Pamoshugand]<INFO>jor_sanct,257,115,0,101,0</INFO></NAVI>." },
		Summary = "Reset at 04:00"
	},
	[8845] = {
		Title = "Example of Silent Answer",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Pamoshugand]<INFO>jor_sanct,257,115,0,101,0</INFO></NAVI> asks you to get 20x <ITEM>[Large Gray Feather]<INFO>1001244</INFO></ITEM>. ...But whose orders are these? Doririrogand?" },
		Summary = "Deliver 20 Large Gray Feathers"
	},
	[18234] = {
		Title = "Iwin's Iwin Worry",
		IconName = "ico_ep.bmp",
		Description = { "A request from Ice Castle's <NAVI>[Chichiring]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>. In order to ensure the safety of the ancient Ice Winds, you must defeat the monsters in the Deep Roots Cave." },
		Summary = "Defeat 30 monsters in the Deep Roots Cave"
	},
	[18235] = {
		Title = "[Standby] Iwin's Iwin Worry",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Chichiring]<INFO>icecastle,75,126,0,101,0</INFO></NAVI> in Ice Castle." },
		Summary = "04:00 Reset"
	},
	[18236] = {
		Title = "Voglinde's Extermination Operation 1",
		IconName = "ico_ep.bmp",
		Description = { "Issgard's <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> wants to exterminate the monsters coming out of the 1st floor of the Snake's Roots. Let's go wild with them!" },
		Summary = "Defeat 30 Rgans on the Roots 1st floor"
	},
	[18237] = {
		Title = "[Standby] Voglinde's Extermination Operation 1",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> in Issgard." },
		Summary = "04:00 Reset"
	},
	[18238] = {
		Title = "Voglinde's Extermination Operation 2",
		IconName = "ico_ep.bmp",
		Description = { "Issgard's <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> wants to exterminate the monsters coming out of the 2nd floor of the Snake's Roots. Let's go wild with them!" },
		Summary = "Defeat 30 Rgans on the Roots 2nd floor"
	},
	[18239] = {
		Title = "[Standby] Voglinde's Extermination Operation 2",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> in Issgard." },
		Summary = "04:00 Reset"
	},
	[23110] = {
		Title = "[Standby] Pulling Out Jormungandr's Roots",
		IconName = "ico_dq.bmp",
		Description = { "It seems like you've done enough for today. If the threat is too great, it might backfire, so if you want to clear out the Jormungandr Cult Ritualists in the Frozen Zone, wait until tomorrow." },
		Summary = "Resets at 04:00"
	},
	[23111] = {
		Title = "Pulling Out Jormungandr's Roots",
		IconName = "ico_ep.bmp",
		Description = { "You've received a request from <NAVI>[Kororo]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI>. Let's confront the Jormungandr Cult Ritualists wandering in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Defeat 15 Jormun Warlocks"
	},
	[18334] = {
		Title = "A Rift Detected in the North",
		IconName = "ico_ep.bmp",
		Description = { "Nillem believes a rift has opened on Scale Island, near Issgard, and wants to look into it. <NAVI>[Shupapa]<INFO>jor_tail,233,41,0,101,0</INFO></NAVI>, waiting at the Frozen Tail, can take you to Scale Island." },
		Summary = "Talk to Nyar"
	},
	[18335] = {
		Title = "The Rift on Scale Island",
		IconName = "ico_ep.bmp",
		Description = { "You crossed into the Scale Island of the past with Nyar. Somewhere in this time lies the source of Rasgand's power, and it has to be destroyed. Talk to <NAVI>[Nyar]<INFO>jor_crk_p,105,108,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nyar"
	},
	[18336] = {
		Title = "First Meeting",
		IconName = "ico_ep.bmp",
		Description = { "While you were planning your next move on the Scale Island of the past, you sensed someone nearby. Meet whoever is <NAVI>[near the rift]<INFO>jor_crk_p,95,93,0,101,0</INFO></NAVI>." },
		Summary = "Meet someone near the rift"
	},
	[18337] = {
		Title = "To Lunaforma",
		IconName = "ico_ep.bmp",
		Description = { "The one you met on the Scale Island of the past was Ivan Wigner. Go with <NAVI>[Ivan]<INFO>jor_crk_p,95,93,0,101,0</INFO></NAVI> and his soldier to <NAVI>[Lunaforma]<INFO>jor_mbase,124,32,0,101,0</INFO></NAVI>." },
		Summary = "Talk to a soldier in Lunaforma"
	},
	[23240] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "The moment you reach Lunaforma, the Georborg resistance's base, you hear shouting. From the soldiers' faces, the ones being shouted at are the resistance's <NAVI>[captain]<INFO>jor_mbase,56,152,0,101,0</INFO></NAVI> and vice-captain. Lehar and Nillem suggest listening quietly, out of the line of fire." },
		Summary = "Listen to the argument"
	},
	[23241] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "The believers of Freyja, unhappy with a resistance built around Odin, left Lunaforma to look for another home. Once things calm down, a <NAVI>[resistance soldier]<INFO>jor_mbase,54,155,0,101,0</INFO></NAVI> waves you over." },
		Summary = "Talk to a resistance soldier"
	},
	[23242] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "Tris welcomed you, Lehar and Nillem when you said you wanted to join. Until there is a proper task for you, you are to help Richard's mercenaries. The vice-captain, Tan, doesn't trust you, but Tris has told him to show you the way. Talk to <NAVI>[Tan]<INFO>jor_mbase,57,150,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tan"
	},
	[23243] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "Tan made it clear he doesn't trust you: if you last through the mercenaries' training, he may think again. Head for <NAVI>[Richard's mercenaries]<INFO>jor_mbase,313,106,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "Talk to Richard"
	},
	[24000] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Tan still doesn't trust you. Go to the <NAVI>[mercenaries' office]<INFO>mbase_in,289,124,0,101,0</INFO></NAVI> in south-east Lunaforma and meet Richard." },
		Summary = "Go to the mercenaries' office"
	},
	[24001] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "The office was empty, until a <NAVI>[man]<INFO>mbase_in,292,127,0,101,0</INFO></NAVI> walked in. Ask him where Richard is." },
		Summary = "Talk to the man in the office"
	},
	[24002] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Richard might be in his room. Go to <NAVI>[Richard's room]<INFO>mbase_in,113,120,0,101,0</INFO></NAVI> in the central barracks of Lunaforma." },
		Summary = "To Richard's room"
	},
	[24003] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Richard's room is locked. See if anyone is in the <NAVI>[room next door]<INFO>mbase_in,113,114,0,101,0</INFO></NAVI>." },
		Summary = "The room next door"
	},
	[24004] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "The woman from the room next door tells you to go back to the <NAVI>[mercenaries' office]<INFO>mbase_in,289,124,0,101,0</INFO></NAVI>." },
		Summary = "Back to the office"
	},
	[24005] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "To join Richard's mercenaries you have to fill in the <NAVI>[application forms]<INFO>mbase_in,299,126,0,101,0</INFO></NAVI>." },
		Summary = "Fill in the forms"
	},
	[24006] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Hand your filled-in forms to <NAVI>[Valdaris]<INFO>mbase_in,302,123,0,101,0</INFO></NAVI>, at the back of the office." },
		Summary = "Hand the forms to Valdaris"
	},
	[24007] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "As Valdaris checked your forms, Tan appeared. Talk to <NAVI>[Tan]<INFO>mbase_in,302,122,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tan"
	},
	[24008] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Tan left you with Valdaris and vanished again. Talk to <NAVI>[Valdaris]<INFO>jor_mbase,316,117,0,101,0</INFO></NAVI> outside the office." },
		Summary = "Talk to Valdaris"
	},
	[24009] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Valdaris will show you around Lunaforma. Follow <NAVI>[Valdaris]<INFO>jor_mbase,243,120,0,101,0</INFO></NAVI>." },
		Summary = "Follow Valdaris"
	},
	[24010] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "You heard about the Wigner Company and the Walter fleet. On to the <NAVI>[next stop]<INFO>jor_mbase,145,108,0,101,0</INFO></NAVI>." },
		Summary = "Follow Valdaris"
	},
	[24011] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "You heard about the children of Lunaforma. Something is happening at the <NAVI>[training ground]<INFO>jor_mbase,135,108,0,101,0</INFO></NAVI>." },
		Summary = "Follow Valdaris"
	},
	[24012] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "There's a commotion at the training ground in south Lunaforma. Get <NAVI>[closer]<INFO>jor_mbase,135,108,0,101,0</INFO></NAVI>." },
		Summary = "To the training ground"
	},
	[24013] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "At the training ground you found Richard being beaten up by Galaxia. Take him to <NAVI>[his room]<INFO>mbase_in,167,128,0,101,0</INFO></NAVI> to patch him up." },
		Summary = "To Richard's room"
	},
	[24014] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Valdaris is furious. Ask <NAVI>[Richard]<INFO>mbase_in,168,126,0,101,0</INFO></NAVI> what the fight was about." },
		Summary = "Talk to Richard"
	},
	[24015] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Richard and Galaxia were staging a fight for the illustrations of a combat manual. Look at <NAVI>[Lee]<INFO>mbase_in,166,124,0,101,0</INFO></NAVI>'s drawings." },
		Summary = "Talk to Lee"
	},
	[24016] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Valdaris has words for Richard alone. Give them some room and go to <NAVI>[Galaxia's room]<INFO>mbase_in,167,79,0,101,0</INFO></NAVI>." },
		Summary = "To Galaxia's room"
	},
	[24017] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "You heard about Galaxia and Richard. Go outside and let <NAVI>[Lee]<INFO>jor_mbase,163,196,0,101,0</INFO></NAVI> show you around." },
		Summary = "Talk to Lee"
	},
	[24018] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "You seem to have earned a little trust. Meet <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "To Tris"
	},
	[23244] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "You told Tris how it went with the mercenaries. Nillem has been sent to Alberta and Lehar to the Wigner Company, and Tris has someone to introduce to you. Talk to <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI> again." },
		Summary = "Talk to Tris"
	},
	[23245] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "You were introduced to Heine, the wizard of Comodo, and to her newest invention: Heine's Tablet. Tell <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI> when you are ready for a new task." },
		Summary = "Talk to Tris"
	},
	[23246] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Heine wants you to gather Bright Eyes around Lunaforma yourself. From Tris's face, this was a sudden whim of hers. Hear the rest from <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tris"
	},
	[23247] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Heine notices at once when something isn't done exactly as she said. Defeat 10 Skipskippers on the Raised Land, collect 1 Bright Eye, and report to <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI>." },
		Summary = "1 Bright Eye"
	},
	[23248] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Meanwhile Heine asked Tris to send you to Alberta. Join <NAVI>[Nillem]<INFO>jor_albe,192,209,0,101,0</INFO></NAVI> there." },
		Summary = "To Alberta"
	},
	[23249] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "Back at the barracks of Lunaforma, Heine's Tablet broke down in the middle of a call. <NAVI>[Tris]<INFO>mbase_in,92,123,0,101,0</INFO></NAVI> suggests waiting until Heine calls back." },
		Summary = "Talk to Tris"
	},
	[23250] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The tablet reconnected, but Heine says it needs an overhaul and has named you her repair assistant. Tris lent you a <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> in the barracks." },
		Summary = "To the private room"
	},
	[23251] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "A remote repair never works on the first try, Heine says, so bring plenty of parts: 2 Vellelopy, from the Velellings of the Raised Land. Then return to <NAVI>[Heine]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI>." },
		Summary = "2 Vellelopy"
	},
	[23252] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "Heine has started the repair. Stay in the <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> and assist her." },
		Summary = "Help with the repair"
	},
	[23253] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The first attempt failed. Stay in the <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> and assist her once more." },
		Summary = "Help with the repair"
	},
	[23254] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The tablet works, but Heine had another reason to pick you. You told her why you came from the future. Tell <NAVI>[Tris]<INFO>mbase_in,92,123,0,101,0</INFO></NAVI> the news." },
		Summary = "Talk to Tris"
	},
	[23255] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "With what Leon found and the news you brought from the future, the Georborg resistance decided to prepare the all-out war that will end the fight with the Jormungandr cult. Then there is a loud noise outside. Go <NAVI>[outside]<INFO>jor_mbase,201,192,0,101,0</INFO></NAVI> and see." },
		Summary = "Go outside"
	},
	[8882] = {
		Title = "Ivan Wigner's Pleasant Missionary Life",
		IconName = "ico_ep.bmp",
		Description = { "I was planning to speak with Ivan Wigner at Lunaforma, but both he and Lehar are busy. Let's help <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> prepare the food." },
		Summary = "Talk with Lehar"
	},
	[8883] = {
		Title = "Lehar's Rewarding Relief Work (1)",
		IconName = "ico_ep.bmp",
		Description = { "Lunaforma's shelter has been expanded to provide meals using available ingredients, and it turns out that <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> possesses a hidden talent for perfectly cooking cauldron rice!" },
		Summary = "Talk with Lehar"
	},
	[8884] = {
		Title = "Lehar's Rewarding Relief Work (2)",
		IconName = "ico_ep.bmp",
		Description = { "Thankfully, the Lunaforma shelter is operating smoothly without any major issues. After the meal distribution, I decided to have a meal with <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Lehar"
	},
	[8885] = {
		Title = "He's robbing the whole house!",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> heard that Ivan had poured a considerable amount of money from the Wigner Group into building a shelter in Lunaforma." },
		Summary = "Talk with Lehar"
	},
	[8886] = {
		Title = "Lehar's Rewarding Relief Work (3)",
		IconName = "ico_ep.bmp",
		Description = { "The food distribution at the Lunaforma shelter is complete. Now, let's take a breather and have a meal with <NAVI>[Ivan]<INFO>jor_mbase,189,282,0,101,0</INFO></NAVI> and Lehar." },
		Summary = "Talk with Ivan"
	},
	[8887] = {
		Title = "People who saw the ghost ship (1)",
		IconName = "ico_ep.bmp",
		Description = { "Talk to <NAVI>[Lyric]<INFO>jor_mbase,185,311,0,101,0</INFO></NAVI> in Lunaforma.." },
		Summary = "Talk with Lyric"
	},
	[8888] = {
		Title = "People who saw the ghost ship (2)",
		IconName = "ico_ep.bmp",
		Description = { "Talk to <NAVI>[Lyric]<INFO>jor_mbase,185,311,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "Talk with Lyric"
	},
	[8889] = {
		Title = "Ivan's Scheme",
		IconName = "ico_ep.bmp",
		Description = { "Lyric's story wasn't helpful, but it confirmed the existence of the ghost ship. Let's hear <NAVI>[Ivan]<INFO>jor_mbase,233,277,0,101,0</INFO></NAVI>'s story." },
		Summary = "Talk with Ivan"
	},
	[8890] = {
		Title = "Ivan's Errand",
		IconName = "ico_ep.bmp",
		Description = { "Meet <NAVI>[Lalira Wigner]<INFO>jalbe_in,56,138,0,101,0</INFO></NAVI> at the top of Wigner in Alberta." },
		Summary = "Talk to Lalira Wigner"
	},
	[8891] = {
		Title = "Ivan's Old Folly",
		IconName = "ico_ep.bmp",
		Description = { "At the top of Alberta's Wigner, Lara told Ivan <NAVI>[where]<INFO>jalbe_in,73,187,0,101,0</INFO></NAVI> the item he had requested was." },
		Summary = "Finding the Chest"
	},
	[8892] = {
		Title = "With the Unclaimed Weapon",
		IconName = "ico_ep.bmp",
		Description = { "Then, it's time to return the weapon to its rightful owner. Return to Lunaforma and speak with <NAVI>[Ivan]<INFO>jor_mbase,233,277,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Ivan"
	},
	[8893] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Now, let's regroup and head north to the Rising Lands. It's time to <NAVI>[infiltrate]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI> the cult." },
		Summary = "Infiltrating the Cult"
	},
	[8894] = {
		Title = "The recipient of the letter",
		IconName = "ico_ep.bmp",
		Description = { "Laraira Wigner, at the top of Wigner, asked you to deliver a letter to <NAVI>[Captain Walter]<INFO>jalbe_in,68,46,0,101,0</INFO></NAVI>. Could it be an important letter?" },
		Summary = "Talk with Maristella Walter"
	},
	[17752] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Time to act inside <NAVI>[Gimle]<INFO>jor_tmple1,186,72,0,101,0</INFO></NAVI>, the temple of the Jormungandr cult." },
		Summary = "Enter the temple"
	},
	[17753] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Find out whether anyone in <NAVI>[Gimle]<INFO>jor_tmple1,110,190,0,101,0</INFO></NAVI> wants to escape." },
		Summary = "Search the temple 1"
	},
	[17754] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Look for information about the ghost ship in <NAVI>[Gimle]<INFO>jor_tmple1,186,228,0,101,0</INFO></NAVI>." },
		Summary = "Search the temple 2"
	},
	[17755] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Maybe the 2nd floor of <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI> holds better information?" },
		Summary = "Search the temple 3"
	},
	[17756] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Nothing useful. Meet the others at the meeting point in <NAVI>[Gimle]<INFO>jor_tmple1,188,72,0,101,0</INFO></NAVI>." },
		Summary = "Join the others"
	},
	[17757] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Nobody found anything. Go back to <NAVI>[Lunaforma]<INFO>jor_mbase,143,272,0,101,0</INFO></NAVI> and think of something else." },
		Summary = "To Lunaforma"
	},
	[17758] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "Meet Nadoyo at the meeting place on <NAVI>[Scale Island]<INFO>jor_crk_p,71,85,0,101,0</INFO></NAVI>: Nadoyo knows the inside of the temple." },
		Summary = "To the meeting place"
	},
	[17759] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Ivan]<INFO>jor_crk_p,69,85,0,101,0</INFO></NAVI> has a proposal for those left on Scale Island..." },
		Summary = "Talk to Ivan"
	},
	[17760] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "The talent Ivan talked about works at the canteen of <NAVI>[Lunaforma]<INFO>jor_mbase,166,302,0,101,0</INFO></NAVI>. Can you win him over?" },
		Summary = "To Lunaforma"
	},
	[17761] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Join Nadoyo in the north of the <NAVI>[Raised Land]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI> and hear how to get into the temple." },
		Summary = "To the Raised Land"
	},
	[17762] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Meet Nadoyo, waiting in <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI>, and learn what to watch out for inside the cult. You can't fail twice." },
		Summary = "To the temple's 2nd floor"
	},
	[17763] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "The guard of <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI> needs a moment to check the register." },
		Summary = "Register with the guard"
	},
	[17764] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Karmilgand, a high priest, is locked up somewhere in <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI>. Help him escape." },
		Summary = "Rescue Karmilgand"
	},
	[17765] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "You barely got Karmilgand out. Join the others in the north of the <NAVI>[Raised Land]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI>." },
		Summary = "To the Raised Land"
	},
	[17766] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "The rescue worked. Take Karmilgand and the believers back to <NAVI>[Lunaforma]<INFO>jor_mbase,143,272,0,101,0</INFO></NAVI>." },
		Summary = "To Lunaforma"
	},
	[17767] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "An open square is no place for this talk. Go somewhere quiet in <NAVI>[Lunaforma]<INFO>mbase_in,116,186,0,101,0</INFO></NAVI>." },
		Summary = "Somewhere quiet"
	},
	[17768] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "In the central barracks of <NAVI>[Lunaforma]<INFO>mbase_in,118,186,0,101,0</INFO></NAVI> everyone is talking about Reinhardt. He says he knows about the ghost ship." },
		Summary = "Talk to Reinhardt"
	},
	[17769] = {
		Title = "Report on the Ghost Ship",
		IconName = "ico_ep.bmp",
		Description = { "You have news of the ghost ship. Report to <NAVI>[Maristella]<INFO>jalbe_in,68,46,0,101,0</INFO></NAVI> in Alberta." },
		Summary = "To Maristella"
	},
	[18338] = {
		Title = "Gathering Witnesses",
		IconName = "ico_ep.bmp",
		Description = { "You decided to gather information about the giant serpent. Is it real? Hear the people who made it back to Lunaforma." },
		Summary = "Collect 3 accounts"
	},
	[18339] = {
		Title = "Witness 1",
		IconName = "ico_ep.bmp",
		Description = { "An exhausted soldier says he saw a vile, slimy serpent monster." },
		Summary = ""
	},
	[18340] = {
		Title = "Witness 2",
		IconName = "ico_ep.bmp",
		Description = { "A believer who escaped the cult says he saw the serpent monster eat people." },
		Summary = ""
	},
	[18341] = {
		Title = "Witness 3",
		IconName = "ico_ep.bmp",
		Description = { "A wounded soldier has the scars of huge scales across his back." },
		Summary = ""
	},
	[18342] = {
		Title = "All Accounts Gathered!",
		IconName = "ico_ep.bmp",
		Description = { "You have all the accounts. Report to <NAVI>[Tris]<INFO>jor_mbase,204,193,0,101,0</INFO></NAVI> in front of the central barracks." },
		Summary = "Talk to Tris"
	},
	[18343] = {
		Title = "Looking for Tan and Nadoyo",
		IconName = "ico_ep.bmp",
		Description = { "Tris is worried: Tan and Nadoyo haven't come back. Look for them in the <NAVI>[north of the Raised Land]<INFO>jor_raise1,199,190,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nadoyo"
	},
	[18344] = {
		Title = "A Suspicious Place in the Temple",
		IconName = "ico_ep.bmp",
		Description = { "With Tan, Nadoyo and Reinhardt you will check a suspicious spot outside Gimle. Examine the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> outside the temple." },
		Summary = "Examine the ornamental door"
	},
	[18345] = {
		Title = "The Serpent's Lair?",
		IconName = "ico_ep.bmp",
		Description = { "It seems the cult has made a giant serpent. Hurry back to Lunaforma and tell <NAVI>[Tris]<INFO>jor_mbase,204,193,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tris"
	},
	[18346] = {
		Title = "Left Out of the Last Battle",
		IconName = "ico_ep.bmp",
		Description = { "Tris and the resistance will face the giant serpent. Discuss what comes next with your companions in the <NAVI>[small room]<INFO>mbase_in,64,184,0,101,0</INFO></NAVI> of the central barracks." },
		Summary = "Talk to Nyar"
	},
	[18347] = {
		Title = "I Can't Sit This Out!",
		IconName = "ico_ep.bmp",
		Description = { "Heine urges you to join the battle against the serpent. Hurry to the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> before Tris and the others face it." },
		Summary = "Talk to Nadoyo"
	},
	[18348] = {
		Title = "Joining the Last Battle",
		IconName = "ico_ep.bmp",
		Description = { "Your comrades are searching the hidden place behind the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> for the giant serpent. Fight beside Tris in the last battle recorded in history." },
		Summary = "Fight in the Last Battle"
	},
	[18349] = {
		Title = "Carried Off by a Cat",
		IconName = "ico_ep.bmp",
		Description = { "Nyar appeared out of nowhere and carried you off. She had followed Jormungandr's mana to a hidden space behind the <NAVI>[ornamental altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> of Gimle. Follow her." },
		Summary = "Talk to Nyar"
	},
	[18350] = {
		Title = "Gimle's Suspicious Book",
		IconName = "ico_ep.bmp",
		Description = { "Behind Gimle's <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> lies a hidden room with a very suspicious book. Nillem says it is some kind of mechanism and tells you to press it..." },
		Summary = "Press the suspicious book"
	},
	[18351] = {
		Title = "The Shining Door",
		IconName = "ico_ep.bmp",
		Description = { "Pressing the book opened a shining door below the <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI>. Jormungandr's mana pours out of it. Go in!" },
		Summary = "Through the shining door"
	},
	[18352] = {
		Title = "A Real Mission at Last!",
		IconName = "ico_ep.bmp",
		Description = { "The hidden place behind the <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> leads further. Follow the surging mana and destroy Jormungandr's mana before it gathers in Rasgand." },
		Summary = "Break the secret altar"
	},
	[18353] = {
		Title = "The Source Is Cut Off",
		IconName = "ico_ep.bmp",
		Description = { "After all that, Nyar seems to have caught the mana meant for Rasgand. Discuss the next steps with <NAVI>[Nyar]<INFO>jor_crk_p,105,108,0,101,0</INFO></NAVI> on the Scale Island of the past." },
		Summary = "Talk to Nyar"
	},
	[18354] = {
		Title = "Heine's Gift",
		IconName = "ico_ep.bmp",
		Description = { "Ilse el Heine called through the tablet: take the new tablet she hid in the <NAVI>[bushes]<INFO>jor_mbase,129,43,0,101,0</INFO></NAVI> near the Lunaforma ferry." },
		Summary = "Search the bushes"
	},
	[18355] = {
		Title = "Back to Scale Island",
		IconName = "ico_ep.bmp",
		Description = { "Return to the <NAVI>[Scale Island]<INFO>jor_crk,137,138,0,101,0</INFO></NAVI> of your own time and see whether everything went as planned." },
		Summary = "To Scale Island"
	},
	[18356] = {
		Title = "Time to Check the Consequences",
		IconName = "ico_ep.bmp",
		Description = { "Go to the Nest of Small Branches and check on Rasgand. <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI> can tell how the sealed Rasgand's mana is doing." },
		Summary = "Talk to Nyar's Double"
	},
	[18357] = {
		Title = "Time to Settle the Curse",
		IconName = "ico_ep.bmp",
		Description = { "Voglinde and Lehar went into the barrier to see the end of the curse. Wait and pray they succeed. <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI> will know." },
		Summary = "Wait, then talk to Nyar's Double"
	},
	[18358] = {
		Title = "Rasgand?",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand keeps coming back to life. To check one possibility, you will go into the barrier yourself. Enter the Serene Sanctuary through <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI>." },
		Summary = "Check the Serene Sanctuary"
	},
	[18359] = {
		Title = "Butterfly Effect",
		IconName = "ico_ep.bmp",
		Description = { "As you thought: the Rasgand inside the barrier was not Rasgand. The mana of the shard of Ymir's heart was imitating him. Tell <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nyar's Double"
	},
	[18360] = {
		Title = "The Frozen Age of Heroes",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Nyar]<INFO>jor_crk,105,108,0,101,0</INFO></NAVI> and Nillem, closing the rift on Scale Island, say something strange has happened. Go to Scale Island." },
		Summary = "Talk to Nyar"
	},
	[18361] = {
		Title = "Nyar's Primeval Pouch",
		IconName = "ico_ep.bmp",
		Description = { "Nyar showed off her primeval pouch." },
		Summary = "Talk to Nyar"
	},
	[8914] = {
		Title = "An Unexpected Timeline",
		IconName = "ico_ep.bmp",
		Description = { "I thought nothing would change within a fixed timeline, but I received a new request. Nilem's comment that this meant the present would no longer change played a role. Let's deliver a letter to <NAVI>[Lalira Wigner]<INFO>jalbe_in,56,138,0,101,0</INFO></NAVI> in Alberta." },
		Summary = "Talk to Lalira Wigner"
	},
	[8915] = {
		Title = "Nazar's Eye",
		IconName = "ico_ep.bmp",
		Description = { "Lalira looks genuinely surprised to receive the letter, but suggests we talk in her office. Speak with <NAVI>[Lalira Wigner]<INFO>jalbe_in,71,174,0,101,0</INFO></NAVI> in the office at the Wigner Headquarters in Alberta." },
		Summary = "Talk to Lalira Wigner"
	},
	[8916] = {
		Title = "Returning",
		IconName = "ico_ep.bmp",
		Description = { "Lalira has decided not to accompany you to Lunaforma. You must convey Lalira's choice to <NAVI>[Ivan]<INFO>jor_mbase,332,148,0,101,0</INFO></NAVI>, who will be waiting at Lunaforma." },
		Summary = "Talk with Ivan"
	},
	[12647] = {
		Title = "Memory Repetition",
		IconName = "ico_dq.bmp",
		Description = { "It seems the time of the final battle repeats itself, slightly changing every day. If I return the next day, the same day will repeat itself. Let's witness the final battle again in the cult's temple, in an unknown location hidden behind a <NAVI>[decorative door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI>." },
		Summary = "Resets at 4 AM"
	},
	[12656] = {
		Title = "Final Battle",
		IconName = "ico_dq.bmp",
		Description = { "We cannot even begin to imagine what battle awaits us beyond the gloomy, massive gate before us. Let us go and witness the battle for humanity's survival. Let's witness the final battle again in the cult's temple, in an unknown location hidden behind a <NAVI>[decorative door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI>." },
		Summary = "A Hand in the Flow of History"
	},
}
