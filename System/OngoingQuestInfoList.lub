		IconName = "ico_ep.bmp",
		Description = { "Issgard's <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> wants to exterminate the monsters coming out of the 2nd floor of the Snake's Roots. Let's go wild with them!" },
		Summary = "Defeat 30 Rgans on the Roots 2nd floor"
	},
	[18239] = {
